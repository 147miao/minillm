# ==== LLM（OpenAI 兼容）====
LLM_BASE_URL=http://127.0.0.1:8788/inference/go/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=deepseek-v4.1-flash
SMALL_LLM_BASE_URL=http://127.0.0.1:8788/inference/go/v1
SMALL_LLM_API_KEY=replace-with-your-key
SMALL_LLM_MODEL=glm-5.3-flash
# 网关做会话路由/缓存；留空则不加
LLM_EXTRA_HEADERS={"x-opencode-session":"minillm"}
LLM_TIMEOUT=120
LLM_MAX_TOKENS=16384
INCLUDE_REASONING=true

# ==== 上下文管理 ====
CONTEXT_BUDGET=200000
PRUNE_THRESHOLD=0.5
COMPACT_THRESHOLD=0.8
KEEP_RECENT_TURNS=6
MAX_TOOL_OUTPUT_CHARS=20000
RUN_CODE_OUTPUT_CHARS=8000

# ==== 执行与运行 ====
RUN_CODE_TIMEOUT=120
RUN_CODE_IDLE_TIMEOUT=120
RUN_CODE_MAX_TIMEOUT=900
BASH_TIMEOUT=60
WEB_FETCH_TIMEOUT=20
WEB_FETCH_ALLOW_PRIVATE=false
MAX_STEPS=40
TURN_TIMEOUT=900
DATA_DIR=./data
WORKSPACE_ROOT=./workspace
ALLOW_EXTERNAL_WORKSPACE=false
HOOKS_DIR=./hooks
SKILLS_DIR=./skills
MCP_CONFIG=./mcp.json
SUBAGENT_MAX_DEPTH=1
SUBAGENT_MAX_CONCURRENT=4
WAL_FSYNC=true

# ==== Web ====
HOST=127.0.0.1
PORT=8765
ENABLE_CORS=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
